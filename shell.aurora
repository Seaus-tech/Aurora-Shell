#!/bin/bash
# Aurora Shell Command Center

shell.aurora() {
    case "$1" in
        "lock"|"--lock") 
            clear && source "$HOME/.aurora-shell_2theme/aurora_theme.sh" ;;
        "pass"|"--pass")
            if [ -n "$ZSH_VERSION" ]; then read -rs "?Current Pass: " op; else read -rsp "Current Pass: " op; fi
            echo ""
            if [ "$op" = "$CORRECT_PASSWORD" ]; then
                if [ -n "$ZSH_VERSION" ]; then read -rs "?New Pass: " np; else read -rsp "New Pass: " np; fi
                echo ""
                sed -i '' "s/CORRECT_PASSWORD=\".*\"/CORRECT_PASSWORD=\"$np\"/" "$HOME/.aurora-shell_2theme/aurora_theme.sh"
                CORRECT_PASSWORD="$np" && echo "✅ Updated!"
            else
                echo "❌ Wrong password."
            fi ;;
        "update"|"--update")
            local VER=${2:-"main"}
            local VERSION=$(curl -s "https://raw.githubusercontent.com/YashB-byte/aurora-shell-2/$VER/install.sh" | grep "AURORA SYSTEM INSTALLER" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+')
            
            # Ask for password verification
            if [ -n "$ZSH_VERSION" ]; then 
                read -rs "?Enter password to update: " verify_pass
            else 
                read -rsp "Enter password to update: " verify_pass
            fi
            echo ""
            
            if [ "$verify_pass" != "$CORRECT_PASSWORD" ]; then
                echo -e "\033[0;31m❌ Incorrect password. Update cancelled.\033[0m"
                return 1
            fi
            
            echo -e "\033[0;35m🔄 Updating Aurora Shell to $VERSION from branch: $VER...\033[0m"
            
            # Download installer and run with preserved password
            TEMP_INSTALLER=$(mktemp)
            trap "rm -f '$TEMP_INSTALLER'" EXIT
            curl -s "https://raw.githubusercontent.com/YashB-byte/aurora-shell-2/$VER/install.sh" > "$TEMP_INSTALLER"
            PRESERVED_PASSWORD="$CORRECT_PASSWORD" bash "$TEMP_INSTALLER"
            trap - EXIT
            rm -f "$TEMP_INSTALLER"
            ;;
        *) 
            echo -e "\033[1;35m🌌 Aurora Command Center\033[0m"
            echo "---------------------------------------"
            echo -e "🚀 [1] lock   : Re-engage terminal lock"
            echo -e "🔑 [2] pass   : Change your password"
            echo -e "🔄 [3] update : Pull latest from GitHub"
            echo -e "❓ [4] help   : Show this manual"
            echo "---------------------------------------"
            echo -en "\033[0;36mSelect an option (1-4): \033[0m"
            read -r choice
            case "$choice" in
                1) shell.aurora lock ;;
                2) shell.aurora pass ;;
                3) shell.aurora update ;;
                4|*) echo -e "Usage: shell.aurora [lock|pass|update]" ;;
            esac
            ;;
    esac
}

alias aurora="shell.aurora"
alias auseaia="bash ~/aurora-shell-2/chat.sh"

# Teams CLI wrapper function
teams() {
    # Check if the aurora-teams command exists
    if command -v aurora-teams >/dev/null 2>&1; then
        aurora-teams "$@"
    else
        # Fallback to direct node execution if not installed globally
        node "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Seaus/Aurora-Shell/teams-cli/src/index.js" "$@"
    fi
}
