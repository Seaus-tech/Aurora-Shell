# Setup global platform requirements
platform :ios, '17.0'

target 'Horizon' do
  use_frameworks!

  # Main dependencies shared across targets
  pod 'Alamofire', '~> 5.9'
  pod 'Kingfisher', '~> 7.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Force Xcode 27's compilation planning to stay sequential
      config.build_settings['COMPILATION_MODE'] = 'wholemodule'
      config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
      
      # Ensure deployment targets line up natively for compilation mapping
      config.build_settings['SUPPORTED_PLATFORMS'] = 'iphoneos iphonesimulator macosx appletvos appletvsimulator watchos watchsimulator xros xrsimulator'
    end
  end
end
