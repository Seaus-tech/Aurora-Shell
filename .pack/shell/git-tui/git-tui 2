#!/usr/bin/env zsh
# git-tui — Aurora Git Manager
# Full-screen TUI: status, diff, log, stage, commit, push, AI message
# Usage: git-tui [path]

setopt NO_MONITOR 2>/dev/null

# ── COLOUR / STYLE ────────────────────────────────────────────────────────────
autoload -Uz colors && colors

_C() { printf "\033[%sm" "$1"; }
RST=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
REV=$'\033[7m'

C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_CYAN=$'\033[36m'
C_BLUE=$'\033[34m'
C_MAGENTA=$'\033[35m'
C_WHITE=$'\033[97m'
C_GRAY=$'\033[90m'

# ── TERMINAL SIZE ─────────────────────────────────────────────────────────────
W=$(tput cols)
H=$(tput lines)

# ── STATE ─────────────────────────────────────────────────────────────────────
REPO="${1:-.}"
cd "$REPO" || { echo "Not a git repo"; exit 1; }
git rev-parse --git-dir &>/dev/null || { echo "❌ Not a git repository: $REPO"; exit 1; }

PANEL=status        # status | diff | log | branches
SEL=0               # selected line in current panel
DIFF_FILE=""        # file being diffed
AI_MSG=""           # AI-generated commit message
COMMIT_MSG=""       # current commit message buffer
MODE=normal         # normal | commit | branch | confirm
CONFIRM_ACTION=""

# ── LAYOUT ────────────────────────────────────────────────────────────────────
LEFT_W=$(( W / 3 ))
RIGHT_W=$(( W - LEFT_W - 1 ))
BODY_H=$(( H - 4 ))  # leave room for header (2) + footer (2)

# ── HELPERS ───────────────────────────────────────────────────────────────────
_move()  { printf "\033[%d;%dH" "$1" "$2"; }
_clear() { printf "\033[2J\033[H"; }
_erase_line() { printf "\033[K"; }
_hide_cursor() { printf "\033[?25l"; }
_show_cursor() { printf "\033[?25h"; }
_save_cursor() { printf "\0337"; }
_restore_cursor() { printf "\0338"; }

_pad() {
    local str="$1" width="$2"
    printf "%-${width}s" "$str" | cut -c1-$width
}

_center() {
    local str="$1" width="$2"
    local pad=$(( (width - ${#str}) / 2 ))
    printf "%${pad}s%s%${pad}s" "" "$str" ""
}

_box_line() {
    local char="$1" width="$2"
    printf "%${width}s" | tr ' ' "$char"
}

_git_status_files() {
    git status --porcelain 2>/dev/null
}

_git_staged() {
    git diff --cached --name-status 2>/dev/null
}

_git_unstaged() {
    git diff --name-status 2>/dev/null
}

_git_untracked() {
    git ls-files --others --exclude-standard 2>/dev/null
}

_git_log() {
    git log --oneline --color=never -30 2>/dev/null
}

_git_branches() {
    git branch -a --color=never 2>/dev/null
}

_git_diff_file() {
    local f="$1"
    git diff --color=never -- "$f" 2>/dev/null
    git diff --cached --color=never -- "$f" 2>/dev/null
}

_git_current_branch() {
    git branch --show-current 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null
}

_git_remote() {
    git remote get-url origin 2>/dev/null | sed 's/.*github.com[:/]//' | sed 's/\.git$//'
}

_ai_commit_msg() {
    local diff
    diff=$(git diff --cached --stat 2>/dev/null; git diff --cached --shortstat 2>/dev/null)
    local files
    files=$(git diff --cached --name-only 2>/dev/null | head -10 | tr '\n' ', ')

    # Try Anthropic
    if command -v anthropic &>/dev/null 2>/dev/null; then
        AI_MSG=$(echo "Generate a concise git commit message for: $files" | anthropic 2>/dev/null | head -1)
        return
    fi

    # Try OpenAI
    if [ -n "$OPENAI_API_KEY" ]; then
        AI_MSG=$(curl -sf -X POST https://api.openai.com/v1/chat/completions \
            -H "Authorization: Bearer $OPENAI_API_KEY" \
            -H "Content-Type: application/json" \
            -d "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"Write a concise git commit message (max 72 chars) for changes to: $files. Diff stats: $diff. Reply with only the message.\"}],\"max_tokens\":60}" \
            2>/dev/null | jq -r '.choices[0].message.content // empty' 2>/dev/null | head -1)
        return
    fi

    # Fallback: generate from file names
    local verb="update"
    [[ "$files" == *"fix"* || "$files" == *"bug"* ]] && verb="fix"
    [[ "$files" == *"add"* || "$files" == *"new"* ]] && verb="add"
    [[ "$files" == *"remove"* || "$files" == *"delete"* ]] && verb="remove"
    AI_MSG="$verb: $(echo "$files" | sed 's/,$//' | cut -c1-50)"
}

# ── DRAWING ───────────────────────────────────────────────────────────────────
_draw_header() {
    local branch
    branch=$(_git_current_branch)
    local remote
    remote=$(_git_remote)
    local dirty
    dirty=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')

    _move 1 1
    printf "${BOLD}${C_CYAN}"
    printf "  git-tui"
    printf "${RST}${C_GRAY}  │  "
    printf "${C_MAGENTA}${BOLD} $branch ${RST}"
    printf "${C_GRAY}│  $remote"
    [ "$dirty" -gt 0 ] && printf "  ${C_YELLOW}●${RST}${C_GRAY} $dirty changes"
    _erase_line
    printf "${RST}\n"

    _move 2 1
    printf "${C_GRAY}$(_box_line '─' $W)${RST}\n"
}

_draw_footer() {
    local branch
    branch=$(_git_current_branch)
    _move $(( H - 1 )) 1
    printf "${C_GRAY}$(_box_line '─' $W)${RST}\n"
    _move $H 1
    if [[ $MODE == commit ]]; then
        printf "${C_YELLOW}${BOLD} COMMIT MODE ${RST}${C_GRAY}  Enter=confirm  Esc=cancel  Tab=AI message${RST}"
    elif [[ $MODE == confirm ]]; then
        printf "${C_RED}${BOLD} $CONFIRM_ACTION ${RST}${C_GRAY}  y=yes  n=no${RST}"
    else
        printf "${C_CYAN}[s]${RST}${C_GRAY}tatus "
        printf "${C_CYAN}[d]${RST}${C_GRAY}iff "
        printf "${C_CYAN}[l]${RST}${C_GRAY}og "
        printf "${C_CYAN}[b]${RST}${C_GRAY}ranches  "
        printf "${C_GREEN}[a]${RST}${C_GRAY}dd "
        printf "${C_GREEN}[c]${RST}${C_GRAY}ommit "
        printf "${C_GREEN}[p]${RST}${C_GRAY}ush "
        printf "${C_YELLOW}[u]${RST}${C_GRAY}nstage "
        printf "${C_RED}[x]${RST}${C_GRAY}discard  "
        printf "${C_MAGENTA}[?]${RST}${C_GRAY}help "
        printf "${C_GRAY}[q]${RST}${C_GRAY}uit${RST}"
    fi
    _erase_line
}

_draw_status_panel() {
    local -a lines
    local idx=0

    # Staged
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local st="${line:0:2}"
        local f="${line:3}"
        local staged_char="${st:0:1}"
        local unstaged_char="${st:1:1}"
        if [[ "$staged_char" != " " && "$staged_char" != "?" ]]; then
            lines+=("STAGED:$staged_char:$f")
        fi
    done < <(_git_status_files)

    # Unstaged + untracked
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local st="${line:0:2}"
        local f="${line:3}"
        local staged_char="${st:0:1}"
        local unstaged_char="${st:1:1}"
        if [[ "$unstaged_char" != " " && "$staged_char" == " " ]]; then
            lines+=("UNSTAGED:$unstaged_char:$f")
        elif [[ "$st" == "??" ]]; then
            lines+=("UNTRACKED:?:$f")
        fi
    done < <(_git_status_files)

    local total=${#lines[@]}
    local start=$(( SEL > BODY_H - 1 ? SEL - BODY_H + 1 : 0 ))

    for (( i=0; i<BODY_H; i++ )); do
        _move $(( i + 3 )) 1
        local li=$(( i + start ))
        if [[ $li -ge $total ]]; then
            printf "%${LEFT_W}s" "" ; _erase_line
            continue
        fi

        local entry="${lines[$li]}"
        local type="${entry%%:*}"
        local rest="${entry#*:}"
        local code="${rest%%:*}"
        local file="${rest#*:}"

        local prefix color
        case "$type" in
            STAGED)    prefix="✚" ; color="$C_GREEN"   ;;
            UNSTAGED)  prefix="●" ; color="$C_RED"     ;;
            UNTRACKED) prefix="?" ; color="$C_YELLOW"  ;;
        esac

        if [[ $li -eq $SEL ]]; then
            printf "${REV}"
            DIFF_FILE="$file"
        fi
        printf " ${color}${prefix}${RST} $(_pad "$file" $(( LEFT_W - 4 )))"
        [[ $li -eq $SEL ]] && printf "${RST}"
        _erase_line
        printf "\n"
    done

    STATUS_LINES=("${lines[@]}")
    STATUS_COUNT=$total
}

_draw_diff_panel() {
    local file="${DIFF_FILE:-}"
    local col=$(( LEFT_W + 2 ))
    local w=$(( RIGHT_W - 2 ))

    if [[ -z "$file" ]]; then
        _move 3 $col
        printf "${C_GRAY}  Select a file to view diff${RST}"
        return
    fi

    _move 3 $col
    printf "${BOLD}${C_CYAN}  diff: $file${RST}"
    _erase_line

    local -a diff_lines
    while IFS= read -r line; do
        diff_lines+=("$line")
    done < <(_git_diff_file "$file")

    local dh=$(( BODY_H - 1 ))
    for (( i=0; i<dh; i++ )); do
        _move $(( i + 4 )) $col
        local dl="${diff_lines[$i]:-}"
        local color="$RST"
        case "${dl:0:1}" in
            '+') color="$C_GREEN" ;;
            '-') color="$C_RED"   ;;
            '@') color="$C_CYAN"  ;;
            '\\') color="$C_GRAY" ;;
        esac
        printf "${color}$(_pad "$dl" $w)${RST}"
        _erase_line
    done
}

_draw_log_panel() {
    local col=$(( LEFT_W + 2 ))
    local w=$(( RIGHT_W - 2 ))
    local i=0

    _move 3 $col
    printf "${BOLD}${C_CYAN}  commit log${RST}"
    _erase_line

    while IFS= read -r line; do
        (( i >= BODY_H - 1 )) && break
        _move $(( i + 4 )) $col
        local hash="${line%% *}"
        local msg="${line#* }"
        printf "${C_YELLOW}$hash${RST} ${C_GRAY}$(_pad "$msg" $(( w - 8 )))${RST}"
        _erase_line
        (( i++ ))
    done < <(_git_log)

    for (( ; i < BODY_H - 1; i++ )); do
        _move $(( i + 4 )) $col
        _erase_line
    done
}

_draw_branches_panel() {
    local col=$(( LEFT_W + 2 ))
    local w=$(( RIGHT_W - 2 ))
    local i=0
    local current
    current=$(_git_current_branch)

    _move 3 $col
    printf "${BOLD}${C_CYAN}  branches${RST}"
    _erase_line

    while IFS= read -r line; do
        (( i >= BODY_H - 1 )) && break
        _move $(( i + 4 )) $col
        local clean="${line#\* }"
        clean="${clean#  }"
        if [[ "$line" == *"* "*  ]]; then
            printf "${C_GREEN}${BOLD}  * $(_pad "$clean" $(( w - 4 )))${RST}"
        elif [[ "$clean" == remotes/* ]]; then
            printf "${C_GRAY}    $(_pad "$clean" $(( w - 4 )))${RST}"
        else
            printf "    $(_pad "$clean" $(( w - 4 )))"
        fi
        _erase_line
        (( i++ ))
    done < <(_git_branches)

    for (( ; i < BODY_H - 1; i++ )); do
        _move $(( i + 4 )) $col
        _erase_line
    done
}

_draw_separator() {
    for (( i=3; i<=H-2; i++ )); do
        _move $i $LEFT_W
        printf "${C_GRAY}│${RST}"
    done
}

_draw_commit_overlay() {
    local ow=60 oh=10
    local oy=$(( (H - oh) / 2 ))
    local ox=$(( (W - ow) / 2 ))

    # Box
    _move $oy $ox
    printf "${C_CYAN}╭$(_box_line '─' $(( ow - 2 )))╮${RST}"
    for (( i=1; i<oh-1; i++ )); do
        _move $(( oy + i )) $ox
        printf "${C_CYAN}│${RST}%$(( ow - 2 ))s${C_CYAN}│${RST}"
    done
    _move $(( oy + oh - 1 )) $ox
    printf "${C_CYAN}╰$(_box_line '─' $(( ow - 2 )))╯${RST}"

    _move $(( oy + 1 )) $(( ox + 2 ))
    printf "${BOLD}${C_CYAN} Commit Message${RST}"

    _move $(( oy + 3 )) $(( ox + 2 ))
    printf "${C_GRAY}> ${C_WHITE}$(_pad "$COMMIT_MSG" $(( ow - 6 )))${RST}${C_CYAN}█${RST}"

    if [[ -n "$AI_MSG" ]]; then
        _move $(( oy + 5 )) $(( ox + 2 ))
        printf "${C_GREEN}AI: ${RST}$(_pad "$AI_MSG" $(( ow - 6 )))"
        _move $(( oy + 6 )) $(( ox + 2 ))
        printf "${C_GRAY}Tab to use AI message${RST}"
    else
        _move $(( oy + 5 )) $(( ox + 2 ))
        printf "${C_GRAY}Tab = generate AI message${RST}"
    fi

    _move $(( oy + 8 )) $(( ox + 2 ))
    printf "${C_GRAY}Enter=commit  Esc=cancel${RST}"
}

_render() {
    _hide_cursor
    _draw_header
    _draw_status_panel
    _draw_separator
    case $PANEL in
        status|diff) _draw_diff_panel ;;
        log)         _draw_log_panel ;;
        branches)    _draw_branches_panel ;;
    esac
    _draw_footer
    [[ $MODE == commit ]] && _draw_commit_overlay
}

# ── ACTIONS ───────────────────────────────────────────────────────────────────
_action_stage() {
    [[ -z "$DIFF_FILE" ]] && return
    git add "$DIFF_FILE" 2>/dev/null
}

_action_unstage() {
    [[ -z "$DIFF_FILE" ]] && return
    git restore --staged "$DIFF_FILE" 2>/dev/null
}

_action_discard() {
    [[ -z "$DIFF_FILE" ]] && return
    CONFIRM_ACTION="Discard changes to $DIFF_FILE?"
    MODE=confirm
}

_action_push() {
    local branch
    branch=$(_git_current_branch)
    CONFIRM_ACTION="Push to origin/$branch?"
    MODE=confirm
}

_action_commit() {
    if git diff --cached --quiet 2>/dev/null; then
        # nothing staged — show message
        DIFF_FILE=""
        return
    fi
    MODE=commit
    COMMIT_MSG=""
    AI_MSG=""
}

_do_commit() {
    local msg="${COMMIT_MSG:-$AI_MSG}"
    [[ -z "$msg" ]] && return
    _show_cursor
    _clear
    git commit -m "$msg"
    sleep 1
    _hide_cursor
    MODE=normal
    COMMIT_MSG=""
    AI_MSG=""
}

_do_push() {
    local branch
    branch=$(_git_current_branch)
    _show_cursor
    _clear
    git push origin "$branch"
    sleep 1.5
    _hide_cursor
    MODE=normal
}

_do_discard() {
    git restore "$DIFF_FILE" 2>/dev/null
    git clean -f "$DIFF_FILE" 2>/dev/null
    MODE=normal
}

# ── INPUT LOOP ────────────────────────────────────────────────────────────────
_read_key() {
    local key
    IFS= read -r -s -k1 key 2>/dev/null
    if [[ "$key" == $'\033' ]]; then
        local seq
        IFS= read -r -s -k2 -t 0.1 seq 2>/dev/null
        key="${key}${seq}"
    fi
    echo "$key"
}

_handle_commit_input() {
    local key="$1"
    case "$key" in
        $'\n'|$'\r')  _do_commit ;;
        $'\033')       MODE=normal; COMMIT_MSG="" ;;
        $'\t')
            _show_cursor
            _move $(( H / 2 )) $(( W / 2 - 10 ))
            printf "${C_CYAN}Generating AI message...${RST}"
            _ai_commit_msg
            [[ -n "$AI_MSG" ]] && COMMIT_MSG="$AI_MSG"
            _hide_cursor
            ;;
        $'\177'|$'\b') COMMIT_MSG="${COMMIT_MSG%?}" ;;
        *)
            [[ ${#key} -eq 1 && "$key" =~ [[:print:]] ]] && COMMIT_MSG+="$key"
            ;;
    esac
}

_handle_confirm_input() {
    local key="$1"
    case "$key" in
        y|Y)
            case "$CONFIRM_ACTION" in
                Discard*) _do_discard ;;
                Push*)    _do_push ;;
            esac
            MODE=normal
            ;;
        n|N|$'\033') MODE=normal ;;
    esac
}

_handle_normal_input() {
    local key="$1"
    case "$key" in
        q|Q) return 1 ;;

        # Navigation
        j|$'\033[B') (( SEL < STATUS_COUNT - 1 )) && (( SEL++ )) ;;
        k|$'\033[A') (( SEL > 0 )) && (( SEL-- )) ;;
        g)           SEL=0 ;;
        G)           SEL=$(( STATUS_COUNT - 1 )) ;;

        # Panel switching
        s) PANEL=status ;;
        d) PANEL=diff ;;
        l) PANEL=log ;;
        b) PANEL=branches ;;

        # Git actions
        a) _action_stage ;;
        u) _action_unstage ;;
        x) _action_discard ;;
        c) _action_commit ;;
        p) _action_push ;;

        # Stage all
        A)
            git add -A 2>/dev/null
            ;;

        # Pull
        P)
            _show_cursor; _clear
            git pull
            sleep 1.5; _hide_cursor
            ;;

        # Fetch
        f)
            git fetch --all 2>/dev/null
            ;;

        # Help
        ?)
            _show_cursor; _clear
            cat << 'HELP'

  git-tui — Aurora Git Manager

  Navigation:   j/k  ↑↓    g=top  G=bottom
  Panels:       s=status  d=diff  l=log  b=branches
  Stage:        a=stage file    A=stage all
  Unstage:      u=unstage file
  Discard:      x=discard changes
  Commit:       c=open commit dialog
  Push:         p=push to origin
  Pull:         P=pull from origin
  Fetch:        f=fetch all
  Quit:         q

  In commit dialog:
    Tab = generate AI commit message
    Enter = commit
    Esc = cancel

HELP
            read -s -k1
            _hide_cursor
            ;;
    esac
    return 0
}

# ── MAIN ──────────────────────────────────────────────────────────────────────
trap '_show_cursor; tput rmcup; exit 0' INT TERM EXIT

tput smcup   # enter alternate screen
_clear
_hide_cursor

while true; do
    # refresh terminal size
    W=$(tput cols); H=$(tput lines)
    LEFT_W=$(( W / 3 ))
    RIGHT_W=$(( W - LEFT_W - 1 ))
    BODY_H=$(( H - 4 ))

    _render

    local key
    key=$(_read_key)

    case $MODE in
        commit)  _handle_commit_input "$key" ;;
        confirm) _handle_confirm_input "$key" ;;
        normal)
            _handle_normal_input "$key" || break
            ;;
    esac
done

_show_cursor
tput rmcup
